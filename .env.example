# ========================================================
# CONFIGURAÇÕES DO SISTEMA SENTINEL LUCCA (.env.example)
# ========================================================

# Servidor Web
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ========================================================
# CONFIGURAÇÕES DE E-MAIL (SMTP)
# ========================================================
# Servidor de e-mail (Ex: smtp.office365.com para Microsoft 365, smtp.gmail.com para Gmail, ou o host/IP interno)
SMTP_SERVER=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Usuário e Senha da conta que fará o disparo dos e-mails
SMTP_USER=
SMTP_PASSWORD=

# Nome e E-mail exibidos no cabeçalho 'De:' (se deixar em branco, usará o próprio SMTP_USER)
SMTP_SENDER_NAME=Sentinel TI - CAPUL
SMTP_SENDER_EMAIL=

# ========================================================
# DESTINATÁRIOS PADRÃO DAS SOLICITAÇÕES DE CONSERTO (RMA)
# ========================================================
# Você pode alterar estes e-mails ou adicionar mais (separados por vírgula)
RMA_DEFAULT_EMAIL_TO=matheuslucca@capul.com.br
RMA_DEFAULT_EMAIL_CC=lucas.ti@capul.com.br
